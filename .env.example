# ─── База данных (MySQL / PlanetScale) ────────────────────────────────────────
# PlanetScale: mysql://user:pass@host/db?ssl={"rejectUnauthorized":true}
# Обычный MySQL: mysql://user:pass@host:3306/dbname
DATABASE_URL=mysql://user:password@host/dbname

# ─── Сессии / JWT ─────────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-here

# ─── Учётные данные администратора ────────────────────────────────────────────
# Логин и пароль для входа в /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# ─── Хранилище фото (AWS S3 или Cloudflare R2) ────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=auto
AWS_S3_BUCKET=jusan-images

# Только для Cloudflare R2 (убрать если используете AWS S3):
# AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ─── Системные ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
